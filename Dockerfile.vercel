# Vercel container deployment for Nuxt/Nitro.
# Vercel detects this filename and routes HTTP traffic to the container.

FROM node:22-alpine AS builder

RUN apk add --no-cache python3 make g++

WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma.config.ts ./
COPY prisma/ ./prisma/

# postinstall generates Prisma Client and runs nuxt prepare.
RUN npm ci --no-audit --no-fund

COPY . .

RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV HOST=0.0.0.0
# Vercel can override PORT at runtime. Port 80 is its container default.
ENV PORT=80

COPY --from=builder /app/.output ./.output
COPY --from=builder /app/generated ./generated
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

EXPOSE 80

CMD ["node", ".output/server/index.mjs"]
