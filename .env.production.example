# ============================================================
# Production environment — copy to .env.production and fill in
# NEVER commit this file with real values to version control
# ============================================================

# PostgreSQL credentials (used by docker-compose to create the DB
# AND by the app to connect to it)
POSTGRES_DB=tabulation_db
POSTGRES_USER=tabulation
POSTGRES_PASSWORD=replace_with_strong_password

# Session encryption key — MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 32
NUXT_SESSION_PASSWORD=replace_with_random_32_char_secret

# Seeded admin email is protected from deletion
SEED_ADMIN_EMAIL=admin@tabulation.local

# Port the app is exposed on the host (default 3000)
APP_PORT=3000
