# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/tabulation_db?schema=public"

# Session encryption key — must be at least 32 characters. Generate with:
#   openssl rand -base64 32
NUXT_SESSION_PASSWORD="change-this-to-a-random-32-character-or-longer-secret"

# Seeded admin email is protected from deletion
SEED_ADMIN_EMAIL="admin@tabulation.local"
